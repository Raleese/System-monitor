# Agent
MONITOR_SERVER_URL=http://127.0.0.1:8000
MONITOR_COLLECTION_INTERVAL=10

# Server
MONITOR_DATABASE_PATH=server/metrics.db
MONITOR_RETENTION_COUNT=1000
MONITOR_CPU_THRESHOLD=90
MONITOR_MEMORY_THRESHOLD=78
MONITOR_DISK_THRESHOLD=95
MONITOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dashboard (put this value in dashboard/.env.local)
VITE_API_URL=http://127.0.0.1:8000